{
  "name": "cbg-lms-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run serve",
    "build": "npm run content:check && tsc --noEmit && vite build && tsx scripts/build-blocks.ts && tsx scripts/build-loader.ts && tsx scripts/build-preview.ts && tsx scripts/check-size.ts",
    "serve": "tsx scripts/serve.ts",
    "test": "vitest run",
    "content:check": "tsx scripts/content-check.ts",
    "images": "tsx scripts/images.ts",
    "explode-frames": "tsx scripts/explode-frames.ts",
    "test:e2e": "playwright test",
    "check:size": "tsx scripts/check-size.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
